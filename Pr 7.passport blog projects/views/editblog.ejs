<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <div align="center">
        <h1>edit blog</h1>
        <form action="/blog/updateuser" method="post" enctype="multipart/form-data">
            <table border="1" cellpadding="6">
                <thead>
                    <tr>
                        <td>id</td>
                        <td><input type="text" name="editid" value="<%=single.id%>" style="width: 95%;"></td>
                    </tr>
                    <tr>
                        <td>title</td>
                        <td><input type="text" name="title" value="<%=single.title%>" style="width: 95%;"></td>
                    </tr>
                    <tr>
                        <td>description</td>
                        <td><input type="text" name="description" value="<%=single.description%>" style="width: 95%;">
                        </td>
                    </tr>
                    <tr>

                        <td>image</td>
                        <td><input type="file" name="image" value="<%=single.image%>"></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td><input type="submit"></td>
                    </tr>

                </thead>
            </table>
        </form>
        <a href="/viewblog">view</a>
    </div>
</body>

</html>
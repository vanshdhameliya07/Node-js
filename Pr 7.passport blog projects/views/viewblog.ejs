<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Blog Page</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            margin: 0;
            padding: 20px;
        }
        .container {
            width: 90%;
            max-width: 340px;
            text-align: center;
        }
        h1 {
            color: #333;
            margin-bottom: 20px;
        }
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
        .blog-card {
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            text-align: left;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }
        .blog-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 5px;
        }
        .blog-content {
            padding: 10px 0;
            flex-grow: 1;
        }
        .blog-title {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }
        .blog-description {
            font-size: 14px;
            color: #555;
            margin: 8px 0;
        }
        .blog-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
        }
        .btn {
            padding: 8px 12px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            color: white;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.3s;
        }
        .btnadd{
            margin-top: 20px;
        }
        .btn.delete {
            background: red;
        }
        .btn.delete:hover {
            background: darkred;
        }
        .btn.edit {
            background: #007bff;
        }
        .btn.edit:hover {
            background: #0056b3;
        }
        .btn.add {
            background: green;
            margin-top: 45px;
            display: inline-block;
            padding: 10px 15px;
        }
        .btn.add:hover {
            background: darkgreen;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>View Blog Page</h1>
        <div class="blog-grid">
            <% record.map((val, i) => { %>
            <div class="blog-card">
                <img src="/<%= val.image %>" alt="Blog Image" class="blog-image">
                <div class="blog-content">
                    <div class="blog-title"><%= val.title %></div>
                    <div class="blog-description"><%= val.description %></div>
                </div>
                <div class="blog-actions">
                    <a href="/blog/edituser?eid=<%= val.id %>" class="btn edit">Edit</a>
                    <a href="/blog/deleteuser?did=<%= val.id %>" class="btn delete">Delete</a>
                </div>
            </div>
            <% }) %>
        </div>
        <a href="/blog/addblog" class="btn add">Add Blog</a>
    </div>
</body>
</html>

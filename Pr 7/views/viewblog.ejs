<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>

    <div align="center">
        <h1> view blog page</h1>
        <table border="1">
            <thead>
                <tr>
                    <td>title</td>
                    <td>description</td>
                    <td>image</td>
                    <td>delete</td>
                    <td>edit</td>
                </tr>
            </thead>
            <tbody>
                <% record.map((val,i)=>{
                    %>
                    <tr>
                        <td>
                            <%=val.title%>
                        </td>
                        <td>
                            <%=val.description%>
                        </td>
                        <td>
                            <img src="/<%=val.image%>" width="95" alt="">
                        </td>
                        <td>
                            <a href="/blog/deleteuser?did=<%=val.id%>">delete</a>
                        </td>
                        <td>
                            <a href="/blog/edituser?eid=<%=val.id%>">edit</a>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
        <a href="/blog/editblog">edit</a>
        <a href="/blog/addblog">add</a>
    </div>

</body>

</html>
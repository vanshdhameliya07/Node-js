<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>

<body>
  <div align="center">
    <h1>view user</h1>
    <table border="1">
      <thead>
        <tr>
          <td>id</td>
          <td>title</td>
          <td>description</td>
          <td>image</td>
          <td>delete</td>
          <td>edit</td>
        </tr>
      </thead>
      <tbody>
        <% record.map((val,i)=>{
          %>
          <tr>
            <td>
              <%=val.id%>
            </td>
            <td>
              <%= val.title %>
            </td>
            <td>
              <%= val.description %>
            </td>
            <td>
              <img src="<%=val.image%>" width="95px" alt="">
            </td>
            <td>
              <a href="/deleteuser?did=<%=val.id%>">delete</a>
            </td>
            <td>
              <a href="/edituser?eid=<%=val.id%>">edit</a>
            </td>
          </tr>
          <% }) %>
      </tbody>

    </table>
    <a href="/blog">blog</a>
  </div>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Website</title>
    <style>
        body {
            font-family: 'Arial', sans-serif; 
            background-color: #f4f4f4;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .blog-card {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); 
            width: 350px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease-in-out; 
           margin-top: 60px;
        }

        .blog-card:hover {
            transform: scale(1.02); 
        }

        .blog-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
        }

        .blog-card-content {
            padding: 20px;
            flex-grow: 1; 
        }

        .blog-card h2 {
            margin-bottom: 10px;
            color: #333;
            font-weight: 600; 
        }

        .blog-card p {
            margin-bottom: 15px;
            color: #555;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            line-height: 1.6; 
        }

        .blog-card-actions {
            display: flex;
            justify-content: space-between;
            margin-top: auto;
            padding: 10px 20px; 
            border-top: 1px solid #eee; 
            background-color: #f9f9f9; 
        }

        .blog-card a {
            background-color: #007bff;
            color: white;
            padding: 8px 14px; 
            border: none;
            border-radius: 4px;
            text-decoration: none;
            transition: background-color 0.3s ease;
            font-size: 14px; 
        }

        .blog-card a:hover {
            background-color: #0056b3;
        }

        .add-blog-link {
            text-align: center;
            margin-top: 20px;
            width: 100%;
        }

        .add-blog-link a {
            background-color: #007bff;
            color: white;
            padding: 12px 20px; 
            border: none;
            border-radius: 4px;
            text-decoration: none;
            transition: background-color 0.3s ease;
            font-size: 16px;
        }

        .add-blog-link a:hover {
            background-color: #0056b3;
        }
    </style>
</head>

<body>
    <% record.map((val, i) => { %>
    <div class="blog-card">
        <img src="/<%=val.image%>" alt="<%=val.title%>">
        <div class="blog-card-content">
            <h2><%=val.title%></h2>
            <p><%=val.description%></p>
        </div>
        <div class="blog-card-actions">
            <a href="/blog/deleteid?did=<%=val.id%>">Delete</a>
            <a href="/blog/editid?eid=<%=val.id%>">Edit</a>
        </div>
    </div>
    <% }) %>

    <div class="add-blog-link">
        <a href="/blog/addblog">Add Blog</a>
    </div>

</body>

</html>
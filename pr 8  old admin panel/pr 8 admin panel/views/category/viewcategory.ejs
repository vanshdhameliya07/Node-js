<%- include('../header')%>
    <style>
        .container-fluid .btn {
            border-radius: 5px;
        }

        .container-fluid .btn a {
            color: white;
        }
    </style>
    <div class="page-wrapper">
        <!-- ============================================================== -->
        <!-- Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <div class="page-breadcrumb">
            <div class="row">
                
                <% if(locals.message?.success){ %>
                    <div class="alert alert-success">
                        <%=locals.message?.success%>
                    </div>
                    <% }%>
                <div class="col-12 d-flex no-block align-items-center">
                    
                    <h4 class="page-title">Tables</h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Library</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
        <!-- ============================================================== -->
        <!-- End Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- Container fluid  -->
        <!-- ============================================================== -->
        <div class="container-fluid">
            <!-- ============================================================== -->
            <!-- Start Page Content -->
            <!-- ============================================================== -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title m-b-0">Static Table</h5>
                        </div>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">srno</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Action</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody>

                                <%category.map((val,i)=>{
                                    %>
                                    <tr>
                                        <td>
                                            <%=++i%>
                                        </td>
                                        <td>
                                            <%=val.category%>
                                        </td>
                                        <td>
                                            <a href="/category/deleteuser?did=<%=val.id%>" class="btn-success btn btn">
                                                <i class="fa fa-trash text-white "></i>
                                            </a>
                                            <a href="/category/edituser?eid=<%=val.id%>" class="btn-primary btn btn">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </td>

                                        <td>
                                            <%if(val.status=="active"){ %>
                                                <a class="btn btn-success btn-sm"
                                                    href="/category/changestatus?id=<%=val.id%>&status=deactive">
                                                    <%=val.status%>
                                                </a>
                                                <% } else{%>
                                                    <a class="btn btn-danger btn-sm"
                                                        href="/category/changestatus?id=<%=val.id%>&status=active">
                                                        <%=val.status%>
                                                    </a>
                                                    <%} %>
                                        </td>
                                    </tr>
                                    <% })%>
                            </tbody>
                        </table>
                    </div>



                </div>
            </div>
            <!-- ============================================================== -->
            <!-- End PAge Content -->
            <!-- ============================================================== -->
            <!-- ============================================================== -->
            <!-- Right sidebar -->
            <!-- ============================================================== -->
            <!-- .right-sidebar -->
            <!-- ============================================================== -->
            <!-- End Right sidebar -->
            <!-- ============================================================== -->
        </div>
        <!-- ============================================================== -->
        <!-- End Container fluid  -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- footer -->
        <!-- ============================================================== -->
        <footer class="footer text-center">
            All Rights Reserved by Matrix-admin. Designed and Developed by <a
                href="https://wrappixel.com">WrapPixel</a>.
        </footer>
        <!-- ============================================================== -->
        <!-- End footer -->
        <!-- ============================================================== -->
    </div>
    <%- include('../footer')%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Blog</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(to right, #ff7e5f, #feb47b);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            text-align: center;
            width: 350px;
        }
    </style>
</head>

<body>
    <div class="container">
        <div align="center">
            <h1>add blog</h1>
            <form action="/product/updateuser" method="post" enctype="multipart/form-data">
                <table border="1" cellpadding="10">
                    <thead>

                        <input type="hidden" name="editid" value="<%=record.id%>">

                        <tr>
                            <td>name</td>
                            <td><input type="text" name="name" value="<%=record.name%>" style="width: 95%;"></td>
                        </tr>
                        <tr>
                            <td>price</td>
                            <td><input type="text" name="price" value="<%=record.price%>" style="width: 95%;"></td>
                        </tr>
                        <tr>
                            <td>qty</td>
                            <td><input type="text" name="qty" value="<%=record.qty%>" style="width: 95%;"></td>
                        </tr>
                        <tr>
                            <td>description</td>
                            <td><input type="text" name="description" value="<%=record.description%>"
                                    style="width: 95%;">
                            </td>
                        </tr>

                        <tr>
                            <td>image</td>
                            <td>
                                <input type="file" name="image">
                                <img src="/<%= record.image %>" width="100px" height="60px">
                            </td>
                        </tr>

                        <tr>
                            <td></td>
                            <td><input type="submit"></td>
                        </tr>
                    </thead>
                </table>
            </form>
            <a href="/product/cartuser">viewblog</a>
        </div>
    </div>
</body>

</html>
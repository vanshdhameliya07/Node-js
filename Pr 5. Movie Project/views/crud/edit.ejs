<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    body {
        background-image: linear-gradient(10deg, rgba(0, 0, 0, 0.8500) 10.00%, rgba(0, 0, 0, 0.8465) 17.25%, rgba(0, 0, 0, 0.8361) 24.50%, rgba(0, 0, 0, 0.8187) 31.75%, rgba(0, 0, 0, 0.7944) 39.00%, rgba(0, 0, 0, 0.7632) 46.25%, rgba(0, 0, 0, 0.7250) 53.50%, rgba(0, 0, 0, 0.6868) 60.75%, rgba(0, 0, 0, 0.6556) 68.00%, rgba(0, 0, 0, 0.6312) 75.25%, rgba(0, 0, 0, 0.6139) 82.50%, rgba(0, 0, 0, 0.6035) 89.75%, rgba(0, 0, 0, 0.6000) 97.00%), url('https://assets.nflxext.com/ffe/siteui/vlv3/fb5cb900-0cb6-4728-beb5-579b9af98fdd/web/IN-hi-20250127-TRIFECTA-perspective_efe2d3b6-e8f2-4ce9-b1f8-30b93917a1fb_large.jpg');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0 auto;
    }

    .form-container {
        background: rgba(0, 0, 0, 0.8);
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 0px 10px rgba(255, 255, 255, 0.2);
        color: white;
        width: 400px;
        text-align: center;
    }

    h1 {
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    td {
        padding: 10px;
    }

    input[type="text"],
    input[type="file"] {
        width: 100%;
        border: none;
        padding: 8px;
    }

    input[type="submit"] {
        width: 100%;
        background-color: red;
        color: white;
        border: none;
        padding: 10px;
        font-size: 16px;
        cursor: pointer;
        border-radius: 5px;
        transition: 0.5s;
    }

    input[type="submit"]:hover {
        background: white;
        color: black;
    }
</style>

<body>
    <div align="center" class="form-container">
        <h1>add page</h1>
        <form action="/crud/updaterecord" method="post" enctype="multipart/form-data">
            <table border="1">
                <thead>
                    <tr>
                        <td>id</td>
                        <td><input type="text" name="editid" style="width: 95%;" value="<%= record.id %>"></td>
                    </tr>
                    <tr>
                        <td>name :</td>
                        <td><input type="text" name="name" style="width: 95%;" value="<%= record.name %>"></td>
                    </tr>
                    <tr>
                        <td>description :</td>
                        <td><input type="text" name="description" style="width: 95%;" value="<%= record.description %>">
                        </td>
                    </tr>
                    <tr>
                        <td>price :</td>
                        <td><input type="text" name="price" style="width: 95%;" value="<%= record.price %>"></td>
                    </tr>
                    <tr>
                        <td>image</td>
                        <td><input type="file" name="image">
                            <img src="/<%= record.image %>" width="100px" height="60px" >

                        </td>
                    </tr>

                    <tr>
                        <td></td>
                        <td><input type="submit"></td>
                    </tr>

                </thead>
            </table>
        </form>
        <a href="../crud/view">view</a>
    </div>
</body>

</html>
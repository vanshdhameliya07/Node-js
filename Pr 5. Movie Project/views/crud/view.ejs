<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #141414;
            color: #fff;
            margin: 0;
            padding: 0;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            /* Center items */
            gap: 30px;
            padding: 40px;
        }

        .card {
            background-color: #1e1e1e;
            border: 1px solid #333;
            border-radius: 8px;
            width: 280px;
            padding: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s, box-shadow 0.3s;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* Center card content */
            text-align: center;
        }

        .card img {
            width: 100%;
            height: 180px;
            /* Set height for uniformity */
            object-fit: cover;
            /* Ensure image covers full area */
            border-radius: 5px;
        }

        .card p {
            margin: 10px 0;
        }

        .card a {
            color: white;
            text-decoration: none;
            display: inline-block;
            margin-top: 10px;
            padding: 8px 12px;
            border-radius: 5px;
            background: #333;
            transition: background 0.3s;
        }

        .card a:hover {
            background: #555;
        }

        .add a {
            color: white;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1 style="width: 100%; text-align: center; font-size: 36px; color: #fff;">Movies Collection</h1>

        <% record.map((val, i)=> { %>
            <div class="card">
                <div>
                    <img src="/<%= val.image %>" alt="Movie Image">
                </div>
                <p>
                    <%= val.name %>
                </p>
                <p>Description: <%= val.description %>
                </p>
                <p>Price: <%= val.price %>
                </p>

                <div>
                    <a href="/crud/editid?eid=<%= val.id %>">Edit</a>
                    <a href="/crud/deleteid?did=<%= val.id %>">Delete</a>
                </div>
            </div>
            <% }) %>
    </div>

    <div align="center" class="add">
        <a href="../crud/add" class="add-link">Add New Movie</a>
    </div>


</body>

</html>